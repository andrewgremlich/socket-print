{
  "name": "socket-print",
  "productName": "Provel Print",
  "description": "A CAD-type application that facilitates a faster turnaround time for amputees to receive 3D printed socket for a residual limb.",
  "version": "1.22.11",
  "type": "module",
  "author": {
    "name": "andrewgremlich"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "url": "https://github.com/andrewgremlich/socket-print"
  },
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "vite --config vite.config.ts",
    "mock-printer": "cd deno_scripts && deno task mock-printer",
    "build": "npm run test && npm run clean && vite build",
    "preview": "npm run build && wrangler dev",
    "prepare": "husky",
    "test": "vitest run src/ --config ./vite.config.ts",
    "test:watch": "vitest src/ --config ./vite.config.ts",
    "test:coverage": "vitest run --coverage src/",
    "check": "tsc --noEmit && biome check --write ./src",
    "clean": "rimraf ./dist ./.vite ./out ./dev-dist",
    "changelog": "conventional-changelog -p conventionalcommits -i CHANGELOG.md -s",
    "knip": "knip",
    "deploy": "npm run build && wrangler deploy"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "npm run check"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@cloudflare/vite-plugin": "^1.47.0",
    "@types/node": "^26.1.2",
    "@types/three": "^0.185.1",
    "@types/validator": "^13.15.10",
    "@vitest/coverage-v8": "^4.1.10",
    "browserslist": "^4.28.7",
    "conventional-changelog": "^8.1.0",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "husky": "^9.1.7",
    "jsdom": "^30.0.0",
    "knip": "^6.29.0",
    "lightningcss": "^1.33.0",
    "lint-staged": "^17.2.0",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "crc-32": "^1.2.2",
    "dexie": "^4.4.4",
    "hotkeys-js": "^4.0.4",
    "lucide": "1.27.0",
    "mathjs": "^15.2.0",
    "three": "^0.185.1",
    "three-mesh-bvh": "^0.9.13",
    "validator": "^13.15.35"
  }
}
