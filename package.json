{
  "name": "socket-print",
  "productName": "Provel Print",
  "description": "A CAD-type application that facilitates a faster turnaround time for amputees to receive 3D printed socket for a residual limb.",
  "version": "1.24.2",
  "type": "module",
  "author": {
    "name": "andrewgremlich"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "url": "https://github.com/andrewgremlich/socket-print"
  },
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "vite --config vite.config.ts",
    "mock-printer": "cd deno_scripts && deno task mock-printer",
    "build": "npm run test && npm run clean && vite build",
    "preview": "npm run build && wrangler dev",
    "prepare": "husky",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage src/",
    "check": "tsc --noEmit && biome check --write ./src",
    "clean": "rimraf ./dist ./.vite ./out ./dev-dist",
    "changelog": "conventional-changelog -p conventionalcommits -i CHANGELOG.md -s",
    "knip": "knip",
    "deploy": "npm run build && wrangler deploy"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "npm run check"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@cloudflare/vite-plugin": "^1.58.0",
    "@types/node": "^26.6.2",
    "@types/three": "^0.186.0",
    "@types/validator": "^13.15.10",
    "@vitest/coverage-v8": "^5.0.1",
    "browserslist": "^4.29.0",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "knip": "^6.38.0",
    "lightningcss": "^1.33.0",
    "lint-staged": "^17.5.1",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.137.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "crc-32": "^1.2.2",
    "dexie": "^4.4.6",
    "hotkeys-js": "^4.0.8",
    "lucide": "1.47.0",
    "mathjs": "^15.2.0",
    "three": "0.185.0",
    "three-mesh-bvh": "^0.9.15",
    "validator": "^13.15.35"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "workerd@1.20260921.1": true
  }
}
